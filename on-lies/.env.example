# Copy to .env and fill in your own Supabase project settings.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
PORT=3000

# Optional public Cloudflare Web Analytics site token (32 hex characters).
# Leave empty to disable analytics; enabled only in production builds.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
