# Port configuration (Render automatically injects PORT)
PORT=3000

# MongoDB Connection String (MongoDB Atlas or self-hosted)
# Replace with your connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/onlies_db?retryWrites=true&w=majority

# Database Name (optional, defaults to onlies_db)
DB_NAME=onlies_db
